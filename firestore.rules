rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActive() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Users collection
    match /users/{userId} {
      allow list: if true; // first-run detection
      allow get: if isAuth() && isActive();
      allow create: if isAdmin() || (isAuth() && request.auth.uid == userId); // admin creates staff, or bootstrap first admin
      allow update, delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if isAuth() && isActive();
      allow write: if isAdmin();
    }

    match /pageStaffAssignments/{assignId} {
      allow read: if isAuth() && isActive();
      allow write: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isAuth() && isActive();
      allow write: if isAdmin();
    }

    match /entries/{entryId} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && isActive();
      allow delete: if isAdmin() || (isActive() && (resource.data.staffId == request.auth.uid || resource.data.createdBy == request.auth.uid));
      allow update: if isAdmin() || (isActive() && (resource.data.staffId == request.auth.uid || resource.data.createdBy == request.auth.uid));
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if isAuth() && isActive();
    }

    match /settings/{settingId} {
      allow read: if isAuth() && isActive();
      allow write: if isAdmin();
    }
  }
}
